#include <QVariantList>
#include <QVariantMap>

class UplinkUi
{
    // ---- App -------------------------------------------------------------

    PROP(QString lastError READONLY)

    // Re-reads the node, settles pending operations, re-reads the referral state, and
    // claims when auto-claim is on.
    SLOT(void refresh())

    // ---- Node: blockchain_module -----------------------------------------

    // What stops the node from taking part, in the order the user should fix it:
    // blockchain_module missing; node stopped; not Online yet; Edge (no Blend
    // declaration); core with no healthy Blend peers (port unreachable?); core, but
    // the module can't report the provider_id yet (logos-blockchain-module 108).
    ENUM NodeIssue {
        NoIssue           = 0,
        ModuleUnavailable = 1,
        NodeNotRunning    = 2,
        NodeBootstrapping = 3,
        NotCoreNode       = 4,
        NoBlendPeers      = 5,
        NodeIdUnavailable = 6
    }

    PROP(int nodeIssue READONLY)
    PROP(QString nodeIssueDetail READONLY)
    PROP(QString nodeMode READONLY)           // Online | Bootstrapping | NotStarted | ""
    PROP(bool nodeCore READONLY)
    PROP(int healthyBlendPeers READONLY)
    PROP(QString nodeId READONLY)             // BlendSigning provider_id; "" until known
    PROP(QString chainId READONLY)

    // ---- Deployment: the referral program this release uses -------------

    // The release's program account (metadata.json's referral_program, read at startup) is
    // selected in uplink_module; ProgramUnknown until checked, which needs the LEZ wallet
    // open. ProgramOtherNetwork: the node is on another chain than the release's.
    // ProgramNotConfigured: neither the release nor the module names a deployment.
    // ProgramNotDeployed / ProgramMismatch: nothing, or another version, at that account.
    ENUM ProgramIssue {
        ProgramUnknown       = 0,
        ProgramReady         = 1,
        ProgramNotConfigured = 2,
        ProgramOtherNetwork  = 3,
        ProgramNotDeployed   = 4,
        ProgramMismatch      = 5
    }

    PROP(int programIssue READONLY)
    PROP(QString programIssueDetail READONLY)

    // ---- The node app: what the node's key provides ------------------------

    // The node's key stays with the node app (the Blockchain app), which asks the user each
    // time: joining needs its signature (node.sign_referral_enrolment), cashing out its receipt
    // secret (node.referral_receipt_secret), a payout code its signature
    // (node.sign_referral_payout). While Uplink waits for one, signRequest is
    // {ref, intent, params}: QML raises the intent and passes the answer back with ref
    // (completeSignRequest, or reportSignFailed); an answer for an older ref is ignored.
    // {} otherwise, and in mock mode, where a mock node app answers.
    PROP(QVariantMap signRequest READONLY)
    SLOT(void completeSignRequest(QString requestRef, QVariantMap answer))
    SLOT(void reportSignFailed(QString requestRef, QString error))

    // ---- Terms: uplink_module ------------------------------------------

    PROP(int termsVersion READONLY)
    PROP(QString termsSha256 READONLY)
    PROP(QString termsLastUpdated READONLY)
    PROP(QVariantList termsSections READONLY) // [{title, items: [{t, h?, i?}]}]
    PROP(bool termsAccepted READONLY)

    SLOT(void acceptTerms())

    // ---- Referral programme: uplink_module + lez_core ------------------

    // NoWalletOpen: QML sends basecamp.apps.launch {app: "lez_wallet_ui"}; the shell offers an install if it's missing.
    ENUM WalletIssue {
        WalletReady        = 0,
        LezCoreUnavailable = 1,
        NoWalletOpen       = 2
    }

    // Joining: AwaitingSignature (the node app is asked to sign), Enrolling (the registration
    // is proved and sent: minutes without RISC0_DEV_MODE), EnrolSent (waiting for it to settle).
    ENUM EnrolState {
        NoIdentity        = 0,
        IdentityCreated   = 1,
        Invited           = 2,
        Enrolling         = 3,
        Enrolled          = 4,
        EnrolRejected     = 5,
        AwaitingSignature = 6,
        EnrolSent         = 7
    }

    ENUM InvitationCheck {
        InvitationEmpty   = 0,
        InvitationInvalid = 1,
        InvitationOwn     = 2,
        InviterNotJoined  = 3,
        InvitationOk      = 4
    }

    // Cash out collects what's claimable (one claim per batch of epochs), asks the node app for
    // the receipt secret (AwaitingReceiptKey), cashes the whole balance out with it, then has
    // the node app sign the payout code (SigningCode). payoutCodeFor starts at PreparingCode,
    // for a receipt already cashed out.
    ENUM CashOutState {
        CashOutIdle        = 0,
        Collecting         = 1,
        CashingOut         = 2,
        PreparingCode      = 3,
        CashOutDone        = 4,
        AwaitingReceiptKey = 5,
        SigningCode        = 6
    }

    ENUM OperationStatus {
        OperationPending  = 0,
        OperationSettled  = 1,
        OperationRejected = 2
    }

    PROP(int walletIssue READONLY)
    PROP(QString walletIssueDetail READONLY)
    PROP(int syncedBlock READONLY)
    PROP(int chainHeight READONLY)

    PROP(int enrolState READONLY)
    // Your node is registered. Until enrolState is Enrolled, that's with a points account Uplink
    // hasn't found in this wallet: findingAccount while it looks (a wallet restored from its
    // recovery phrase has its accounts back, but not their labels), then it's another wallet's.
    PROP(bool nodeRegistered READONLY)
    PROP(bool findingAccount READONLY)
    PROP(QString participantId READONLY)
    PROP(QString identityLabel READONLY)      // the identity account's name in the LEZ Wallet app
    PROP(QString identityAddress READONLY)    // base58, as the LEZ Wallet app shows it
    PROP(QString referrerNode READONLY)       // "" = own tree
    PROP(QString invitation READONLY)         // your shareable invitation code; "" until enrolled
    PROP(int invitationCheck READONLY)        // checkInvitation's verdict on the pasted code
    PROP(QString invitationInviter READONLY)  // the inviter's node in the pasted code
    PROP(int epoch READONLY)
    PROP(int activeCount READONLY)
    PROP(QVariantList myActivity READONLY)    // last 16 published epochs, oldest first: 1 active, 0 not, -1 unknown
    PROP(bool nodeActive READONLY)            // your own node is in this epoch's active set; only such epochs pay
    PROP(bool nodeLeftCore READONLY)
    // The points account joined with another node (accountNodeId) than the one running (nodeId):
    // the running node earns nothing for it, and can't sign its cash-outs or payout codes.
    // Known only when both ids are.
    PROP(bool accountOnOtherNode READONLY)
    PROP(QString accountNodeId READONLY)          // not a Blend core node now, but active in one of myActivity's epochs
    PROP(QVariantList referrals READONLY)     // [{node, label, activeThisEpoch, lastPaidEpoch, pending, activity, joinedEpoch, joinedAgo}]; activity as myActivity, -2 before it joined
    PROP(QString claimablePoints READONLY)
    // Published epochs not counted yet (their active sets are in neither the module's record
    // nor the indexer), by the indexer's state: catching up, not running, caught up without
    // them (following another chain), or failing. historyPointsWaiting is what they pay at least.
    ENUM HistoryState {
        HistoryComplete     = 0,
        HistorySyncing      = 1,
        HistoryNeeded       = 2,
        HistoryMissing      = 3,
        HistoryIndexerError = 4
    }
    PROP(int historyState READONLY)
    PROP(int historyMissingEpochs READONLY)
    PROP(QString historyPointsWaiting READONLY)
    PROP(QString rewardBalance READONLY)      // collected, not yet cashed out
    PROP(QString totalPoints READONLY)        // rewardBalance + claimablePoints
    PROP(QString cashedOutPoints READONLY)    // every receipt so far
    PROP(QVariantList receipts READONLY)      // [{index, account, points}], oldest first
    PROP(int cashOutState READONLY)
    // Finding cash-outs this Basecamp doesn't know of (made before its data was lost or on
    // another computer): the node app is asked for the receipt secret (SearchAwaitingKey), then
    // they're looked up on chain (SearchDone, receiptsFound of them new here).
    ENUM ReceiptSearch {
        SearchIdle        = 0,
        SearchAwaitingKey = 1,
        SearchDone        = 2
    }
    PROP(int receiptSearch READONLY)
    PROP(int receiptsFound READONLY)
    PROP(bool accountFoundAgain READONLY)
    PROP(QString cashOutError READONLY)       // why the last cash-out stopped; "" from the next start
    PROP(QString payoutCode READONLY)         // for the payout form, once CashOutDone
    PROP(QString payoutPoints READONLY)       // what that code is for
    PROP(QString payoutFormUrl READONLY)      // where the user pastes the code
    PROP(QVariantList operations READONLY)    // [{ref, kind, status}]

    // Claims on each refresh whenever something is claimable. On unless the user turns it off.
    PROP(bool autoClaim READONLY)
    SLOT(void changeAutoClaim(bool on))

    SLOT(void createIdentity())
    SLOT(void checkInvitation(QString code))
    SLOT(void joinUnder(QString code))
    // Joins: the node app signs the enrolment (AwaitingSignature), then Register is sent.
    SLOT(void enrol())
    SLOT(void cashOutAll())
    SLOT(void payoutCodeFor(int receiptIndex))   // the code for a past receipt
    SLOT(void findPastCashOuts())
    SLOT(void finishCashOut())               // back to idle once the code is copied
    SLOT(void setReferralLabel(QString node, QString label))
}
